{
  "name": "RescueReview",
  "type": "object",
  "properties": {
    "rescue_email": {
      "type": "string",
      "description": "Email of the rescue being reviewed"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating (1-5)"
    },
    "title": {
      "type": "string",
      "description": "Review title/summary"
    },
    "comment": {
      "type": "string",
      "description": "Detailed review comment"
    },
    "experience_type": {
      "type": "string",
      "enum": [
        "adoption",
        "volunteering",
        "donation",
        "visit",
        "other"
      ],
      "description": "Type of experience with the rescue"
    }
  },
  "required": [
    "rescue_email",
    "reviewer_name",
    "reviewer_email",
    "rating"
  ]
}