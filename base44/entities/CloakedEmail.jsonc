{
  "name": "CloakedEmail",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "The actual email address of the user"
    },
    "cloaked_email": {
      "type": "string",
      "description": "The generated random cloaked email address"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cloaked email was created"
    },
    "email_count": {
      "type": "number",
      "default": 0,
      "description": "Number of emails received at this cloaked address"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the active cloaked email for the user"
    }
  },
  "required": [
    "user_email",
    "cloaked_email"
  ]
}